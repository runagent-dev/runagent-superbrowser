node_modules/
build/
dist/
.env
*.js.map
*.d.ts
!src/**/*.d.ts
downloads/
/tmp/

# Python virtualenvs and caches
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Test output
coverage/

workspace/.nanobot/
workspace/memory/
workspace/session/nanobot/workspace*/**/*.jsonl
# NOTE: the per-role SOUL.md files ARE the agents' system prompts and are
# force-included into the wheel (pyproject.toml). They MUST stay tracked so a
# fresh `git clone` build ships them — do NOT ignore them. Runtime workspace
# copies live in $HOME/.superbrowser, not here.
nanobot/workspace*/learnings/
nanobot/workspace*/memory/
nanobot/workspace*/sessions/
nanobot/workspace*/**/.nanobot/
*.jsonl

todo/

# Research evaluation suite (eval/): source, benchmarks, docs and small
# artifacts are tracked; raw run data is regenerable and stays out of git.
eval/runs/
eval/runs_*/
eval/results/
eval/token_runs/
eval/excluded_runs/
# Derived analysis artifacts are regenerated from runs; keep only the
# offline, deterministic E6 fixture results under version control.
eval/artifacts/*
!eval/artifacts/e6_subelement/
!eval/artifacts/ablate10_paper/
!eval/artifacts/ablate10_paper/*.jsonl
!eval/artifacts/ablate10_paper/tables/
eval/**/__pycache__/
# the global *.jsonl rule above must not hide the frozen benchmark task files
!eval/benchmarks/*.jsonl
!eval/tests/fixtures/**/*.jsonl
# Web console build artifacts
console/node_modules/
console/dist/
console/tsconfig.tsbuildinfo
nanobot/superbrowser_gateway/console_dist/

# BU Bench V1 plaintext tasks (decrypted locally by harness-bench; never commit)
eval/benchmarks/bu_bench_v1.jsonl
eval/benchmarks/bu_smoke.jsonl

# Agent run scratch inside the bundled workspaces (screenshots, upload fixtures)
nanobot/workspace_*/crops/
nanobot/workspace_*/*upload*.txt
